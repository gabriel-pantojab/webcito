{
  "name": "webcito",
  "version": "0.0.0",
  "author": "gabther",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:angular dev:electron",
    "dev:angular": "ng serve",
    "dev:electron": "npm run dev:transpile:electron && cross-env NODE_ENV=development electron .",
    "dev:transpile:electron": "vite build --mode development --config vite.electron.config.ts",
    "build:angular": "ng build",
    "dist:win": "npm run transpile:electron && npm run build:angular && electron-builder --win --x64",
    "dist:mac": "npm run transpile:electron && npm run build:angular && electron-builder --mac --arm64",
    "dist:linux": "npm run transpile:electron && npm run build:angular && electron-builder --linux --x64",
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "ng lint"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.1.0",
    "@angular/compiler": "20.1.0",
    "@angular/core": "20.1.0",
    "@angular/forms": "20.1.0",
    "@angular/platform-browser": "20.1.0",
    "@angular/router": "20.1.0",
    "playwright": "1.57.0",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "20.1.1",
    "@angular/cli": "20.1.1",
    "@angular/compiler-cli": "20.1.0",
    "@types/electron": "1.4.38",
    "@types/jasmine": "5.1.0",
    "@types/node": "25.0.10",
    "angular-eslint": "21.0.1",
    "cross-env": "7.0.3",
    "electron": "37.2.3",
    "electron-builder": "26.0.12",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "jasmine-core": "5.8.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "npm-run-all": "4.1.5",
    "prettier": "^3.8.0",
    "prettier-eslint": "^16.4.2",
    "typescript": "5.8.2",
    "typescript-eslint": "8.46.4",
    "vite": "^7.3.1"
  }
}
