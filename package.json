{
  "name": "webcito",
  "version": "0.0.0",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:angular dev:electron",
    "dev:angular": "ng serve",
    "dev:electron": "npm run transpile:electron && cross-env NODE_ENV=development electron .",
    "transpile:electron": "tsc --project src/electron/tsconfig.json",
    "build:angular": "ng build",
    "dist:win": "npm run transpile:electron && npm run build:angular && electron-builder --win --x64",
    "dist:mac": "npm run transpile:electron && npm run build:angular && electron-builder --mac --arm64",
    "dist:linux": "npm run transpile:electron && npm run build:angular && electron-builder --linux --x64",
    "ng": "ng",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "20.1.0",
    "@angular/compiler": "20.1.0",
    "@angular/core": "20.1.0",
    "@angular/forms": "20.1.0",
    "@angular/platform-browser": "20.1.0",
    "@angular/router": "20.1.0",
    "rxjs": "7.8.0",
    "tslib": "2.3.0"
  },
  "devDependencies": {
    "@angular/build": "20.1.1",
    "@angular/cli": "20.1.1",
    "@angular/compiler-cli": "20.1.0",
    "@types/jasmine": "5.1.0",
    "cross-env": "7.0.3",
    "electron": "37.2.3",
    "electron-builder": "26.0.12",
    "jasmine-core": "5.8.0",
    "karma": "6.4.0",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.0",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.1.0",
    "npm-run-all": "4.1.5",
    "typescript": "5.8.2"
  }
}
